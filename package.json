{
  "name": "linuxdo-smart-filter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "LinuxDo 智能降噪过滤器：按板块/标签/标题内容分诊，保护优质内容",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "happy-dom": "^21.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
